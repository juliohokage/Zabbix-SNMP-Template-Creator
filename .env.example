# Flask Configuration
FLASK_ENV=production
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes
SESSION_TIMEOUT=3600

# Logging
LOG_LEVEL=INFO

# CORS Settings
# For production, set this to your specific domain
# Example: CORS_ORIGINS=https://yourapp.com,https://www.yourapp.com
CORS_ORIGINS=*

# Port Configuration
PORT=5000

# File Storage
UPLOAD_FOLDER=/app/uploads
OUTPUT_FOLDER=/app/created_templates
